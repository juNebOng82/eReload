# Default/fallback values for external callers (x-api-key) and the Android
# app (x-app-secret). Once you set these via the admin panel's Settings tab,
# the Firestore-stored value takes priority over these env vars.
API_KEY=change-me-api-key
APP_SECRET=change-me-app-secret

# One-time bootstrap secret used ONLY to create the very first admin login
# account via /admin.html. Never put this in the Android app.
ADMIN_KEY=change-me-admin-key

# Signs admin login sessions. Generate a real random value with:
#   openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret

# Firebase Storage bucket for reload transaction attachments (image/PDF).
# Find this in Firebase Console > Storage — enable Storage first if you
# haven't, then copy the bucket name shown there (no gs:// prefix).
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Fixed secret for Cloud Scheduler (or any automated caller) to trigger the
# timeout check on a timer, without needing an admin to log in. Generate the
# same way as JWT_SECRET (openssl rand -hex 32). Never put this in the
# Android app or any browser-facing page.
CRON_SECRET=change-me-cron-secret
